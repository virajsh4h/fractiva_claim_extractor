# Primary provider
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# Fallback provider 1 (used when Gemini is missing, rate limited or unavailable)
NVIDIA_API_KEY=
# NVIDIA_EXTRACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Fallback provider 2 (OpenRouter free models; used only after Gemini and NVIDIA)
OPENROUTER_KEY=
# OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
